{
  "name": "portfolio-site",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Aditya Gupta portfolio — two static Astro sites built from one codebase.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:precommit": "bash tests/precommit.test.sh",
    "test:static": "bash tests/static-output.test.sh"
  },
  "dependencies": {
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3"
  }
}
