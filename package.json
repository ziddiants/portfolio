{
  "name": "portfolio-site",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Aditya Gupta portfolio — two static Astro sites built from one codebase.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:payments": "node scripts/dev.mjs payments",
    "dev:consumer": "node scripts/dev.mjs consumer",
    "check": "SITE_VERSION=payments astro check",
    "build": "node scripts/build-all.mjs",
    "build:payments": "node scripts/build-all.mjs payments",
    "build:consumer": "node scripts/build-all.mjs consumer",
    "preview:payments": "SITE_VERSION=payments astro preview",
    "preview:consumer": "SITE_VERSION=consumer astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:precommit": "bash tests/precommit.test.sh",
    "test:static": "bash tests/static-output.test.sh",
    "test:versions": "node --test 'tests/versions/*.test.mjs'",
    "pages:setup": "node scripts/pages-setup.mjs",
    "release": "node scripts/release.mjs",
    "test:release": "node --test 'tests/release/*.test.mjs'",
    "test:pages": "node --test 'tests/pages/*.test.mjs'",
    "verify": "node scripts/verify/index.mjs",
    "verify:ci": "node scripts/verify/index.mjs --ci",
    "pdf:prepare": "node scripts/pdf/prepare.mjs",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "parse5": "8.1.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.156.1",
    "yaml": "2.9.1"
  }
}
