#!/usr/bin/env bash
# pre-commit — VF-06 (private files) and VF-16 (secrets) on the staged files (ENG-02, ENG-06).
#
# The rules live in scripts/verify/rules/ and run through the same runner as `npm run verify`,
# so the hook and the build use one list. This hook fails closed: if it cannot run, the commit
# is blocked.
#
# Layer one is this hook. Layer two is .gitignore (N10/N12).

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

if ! command -v node >/dev/null 2>&1; then
  echo "  ✗ commit blocked: node is not installed, so the private-file and secret checks cannot run" >&2
  exit 1
fi

exec node scripts/verify/precommit.mjs
