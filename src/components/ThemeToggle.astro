---
// DS-CMP-22. An icon-only button; the page script (src/scripts/site.ts) makes it work. It starts
// hidden when scripting is off (DR-IX9), so nothing on screen does nothing. The icon is the theme
// you will get: a moon in the light theme, a sun in the dark theme. CSS picks it from the effective
// theme, so the right icon shows before any script runs. aria-pressed and the tooltip are set by
// the script from the same state.
---

<button
  type="button"
  class="theme-toggle"
  aria-label="Dark theme"
  aria-pressed="false"
  title="Switch to dark theme"
>
  <svg
    class="moon"
    viewBox="0 0 20 20"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M16.5 11.5A7 7 0 0 1 8.5 3.5a7 7 0 1 0 8 8z"></path>
  </svg>
  <svg
    class="sun"
    viewBox="0 0 20 20"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="10" cy="10" r="3.5"></circle>
    <path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.3 4.3l1.4 1.4M14.3 14.3l1.4 1.4M4.3 15.7l1.4-1.4M14.3 5.7l1.4-1.4"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--target-min);
    height: var(--target-min);
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--color-text-muted);
    cursor: pointer;
  }
  @media (hover: hover) {
    .theme-toggle:hover {
      color: var(--color-text);
    }
  }
  .sun {
    display: none;
  }
  /* The effective theme is dark: the device is dark and the visitor has not picked Light, or the
     visitor picked Dark (the same two cases as tokens.css). */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .moon {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .sun {
      display: block;
    }
  }
  :global(:root[data-theme='dark']) .moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .sun {
    display: block;
  }
  @media (scripting: none) {
    .theme-toggle {
      display: none;
    }
  }
</style>
