---
// DS-CMP-04 external, L3, VF-13. Opens in a new tab with rel="noopener noreferrer", shows ↗,
// and tells screen readers "(opens in a new tab)". Every link to another site uses this.
import { assertNoOwnAttributes, assertOutsideHref } from '../lib/guards';

import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'a'>, 'rel' | 'target'> {
  href: string;
}
// Other attributes pass through. target and rel belong to the component (L3, VF-13): a caller who
// passes them stops the build, because Astro would put the caller's value after ours.
const { href, class: extra, ...rest } = Astro.props;
assertOutsideHref(href);
assertNoOwnAttributes(rest);
---

<a {...rest} class={extra} href={href} target="_blank" rel="noopener noreferrer">
  <slot />
  <span class="mark" aria-hidden="true">
    {'↗'}
  </span>
  <span class="visually-hidden">{' (opens in a new tab)'}</span>
</a>

<style>
  .mark {
    margin-inline-start: var(--space-1);
  }
</style>
