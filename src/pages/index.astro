---
// The home page frame (ENG-12): the hero and the seven sections in H1 order, each with its header
// and no content yet. ENG-14 built the hero; ENG-15 to ENG-17 fill the sections.
import version from '@version';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { SECTIONS } from '../lib/sections';
---

<BaseLayout title={version.pageTitle}>
  <Hero />
  {SECTIONS.map((s) => (
    <section id={s.id} class="home-section" aria-labelledby={`${s.id}-heading`}>
      <SectionHeader
        number={s.number}
        name={s.name}
        heading={s.heading}
        headingId={`${s.id}-heading`}
      />
    </section>
  ))}
</BaseLayout>
