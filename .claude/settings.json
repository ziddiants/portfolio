{
  "permissions": {
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh api -X PUT:*)",
      "Bash(gh api -X PATCH:*)",
      "Bash(gh api -X POST:*)",
      "Bash(gh api -X DELETE:*)",
      "Bash(gh api --method:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(npx wrangler pages deploy:*)",
      "Bash(wrangler pages deploy:*)",
      "Bash(npx wrangler pages deployment delete:*)",
      "Bash(npm run release -- --env production:*)"
    ]
  }
}
